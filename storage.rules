rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Media Vault: High-res masters
    match /ma_high_res/{allPaths=**} {
      allow read: if request.auth != null; // Restrict high-res to authenticated users/institutions
      allow write: if request.auth != null;
    }
    
    // Public thumbnails and optimized web assets
    match /ma_web_assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
