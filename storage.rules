rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Model images — public read, auth write
    match /models/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dossier images — public read, auth write
    match /dossiers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // High-res masters — auth only
    match /ma_high_res/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
