rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Models — public read for visible records, auth required for writes
    match /ma_models/{document} {
      allow read: if resource.data.isVisible == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Dossiers — public read for visible records, auth required for writes
    match /ma_dossiers/{document} {
      allow read: if resource.data.isVisible == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Articles — public read for visible records
    match /ma_articles/{document} {
      allow read: if resource.data.isVisible == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Users — auth only
    match /ma_users/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
