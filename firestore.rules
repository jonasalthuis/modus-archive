rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ──────────────────────────────────────────────────────
    // Roles live in the `users` collection, keyed by the account's (lowercase) email.
    function loggedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }
    function hasAccount() {
      return loggedIn() && exists(userPath());
    }
    function roleOf() {
      return hasAccount() ? get(userPath()).data.role : null;
    }
    // Owner safety net — mirrors BOOTSTRAP_ADMINS in src/lib/auth.tsx
    function isBootstrapAdmin() {
      return loggedIn() && request.auth.token.email == 'jonasalthuis@gmail.com';
    }
    function isAdmin() {
      return isBootstrapAdmin() || roleOf() == 'admin';
    }
    function isStaff() {
      return isAdmin() || roleOf() == 'editor';
    }

    // ── Content collections ───────────────────────────────────────────────
    // Anyone signed in (incl. anonymous guests) can read published records;
    // staff (admin/editor) can read everything and write. `request.auth != null`
    // (not the stricter loggedIn(), which requires an email claim) is what
    // actually admits anonymous guests while still requiring *some* session —
    // without it, visible content was readable by anyone who could reach the
    // Firestore API directly, without ever going through the invite gate.
    match /ma_models/{document} {
      allow read: if (resource.data.isVisible == true && request.auth != null) || isStaff();
      allow write: if isStaff();
    }
    match /ma_dossiers/{document} {
      allow read: if (resource.data.isVisible == true && request.auth != null) || isStaff();
      allow write: if isStaff();
    }
    match /ma_articles/{document} {
      allow read: if (resource.data.isVisible == true && request.auth != null) || isStaff();
      allow write: if isStaff();
    }
    match /ma_artefacts/{document} {
      allow read: if (resource.data.isVisible == true && request.auth != null) || isStaff();
      allow write: if isStaff();
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // A user may read their own record (needed to resolve their role on login);
    // only admins can read the whole list or write any record. Role must be valid.
    match /users/{document} {
      allow read: if isAdmin() || (loggedIn() && request.auth.token.email == document);
      allow write: if isAdmin()
        && request.resource.data.role in ['admin', 'editor', 'viewer'];
      allow delete: if isAdmin();
    }

    // ── Invite codes ──────────────────────────────────────────────────────
    // Single-document reads are public so a code can be validated before sign-in.
    // List (full collection reads) is admin-only to prevent enumeration.
    // Admins manage them; redemption only allows incrementing useCount by 1.
    match /ma_invites/{document} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Redemption requires a signed-in principal (the client signs in
      // anonymously immediately before this write) — otherwise anyone who
      // merely knows a code, without ever redeeming it, could spam its
      // useCount and lock out the real recipient.
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
            && request.resource.data.useCount == resource.data.useCount + 1);
    }
  }
}
